// Slipstream's windows: the download list and the "download caught" popup.
import { Button, CheckBox, ComboBox, LineEdit, ListView, Palette } from "std-widgets.slint";

// Our own solid colours: the style's background is see-through on Windows 11 (for a
// "Mica" effect the CPU renderer never draws).
global Theme {
    out property <bool> dark: Palette.color-scheme == ColorScheme.dark;
    out property <color> bg: dark ? #1f1f1f : #f9f9f9;
    out property <color> track: dark ? #3a3a3a : #dedede;
}

export struct DownloadRow {
    id: int,
    name: string,
    size: string,
    progress: float,
    speed: string,
    eta: string,
    status: string,
    url: string,
    // Finished: the file is complete on disk.
    done: bool,
    // Downloading or waiting its turn: can be paused.
    active: bool,
}

// One piece of the selected download, as fractions of the bar's width.
export struct SegmentBar {
    x: float,
    w: float,
    fill: float,
}

component Cell inherits Text {
    vertical-alignment: center;
    overflow: elide;
}

component Field inherits HorizontalLayout {
    in property <string> label;
    spacing: 8px;
    Text {
        text: label;
        vertical-alignment: center;
        min-width: 150px;
    }
}

export component MainWindow inherits Window {
    title: "Slipstream";
    background: Theme.bg;
    icon: @image-url("../../../assets/icons/slipstream-128.png");
    preferred-width: 960px;
    preferred-height: 520px;
    min-width: 640px;
    min-height: 320px;

    in property <[DownloadRow]> rows;
    in property <[SegmentBar]> segments;
    in property <string> details;
    in property <string> status-text;
    in-out property <int> selected-id: -1;
    // The selected download's row, for the right-click menu.
    in property <DownloadRow> selected-row;

    // Settings form
    in-out property <string> s-folder;
    in-out property <int> s-connections-index;
    in-out property <string> s-limit;
    in-out property <bool> s-catch;

    callback add-url(string);
    callback pause(int);
    callback resume(int);
    callback remove(int);
    // Remove from the list and delete the finished file from disk.
    callback delete-file(int);
    callback open-file(int);
    callback open-folder(int);
    callback selection-changed(int);
    callback save-settings();

    function select(id: int) {
        root.selected-id = id;
        root.selection-changed(id);
    }

    // Slint has no clipboard call of its own: copy through a hidden text box.
    function copy-text(text: string) {
        clip.text = text;
        clip.select-all();
        clip.copy();
    }

    clip := TextInput {
        width: 0;
        height: 0;
        opacity: 0;
        accessible-role: none;
    }

    // Asks before a finished file is deleted from disk.
    property <int> confirm-id: -1;
    property <string> confirm-name;
    confirm-popup := PopupWindow {
        x: (root.width - self.width) / 2;
        y: 80px;
        width: min(root.width - 16px, 420px);
        close-policy: close-on-click-outside;
        Rectangle {
            background: Theme.bg;
            border-color: Palette.border;
            border-width: 1px;
            border-radius: 6px;
            VerticalLayout {
                padding: 12px;
                spacing: 8px;
                Text {
                    text: "Delete the file?";
                    font-weight: 600;
                }
                Text {
                    text: root.confirm-name + " will be removed from the list and deleted from disk.";
                    wrap: word-wrap;
                }
                HorizontalLayout {
                    alignment: end;
                    spacing: 8px;
                    Button {
                        text: "Cancel";
                        clicked => {
                            confirm-popup.close();
                        }
                    }
                    Button {
                        text: "Delete file";
                        primary: true;
                        clicked => {
                            root.delete-file(root.confirm-id);
                            confirm-popup.close();
                        }
                    }
                }
            }
        }
    }

    add-popup := PopupWindow {
        x: 8px;
        y: 44px;
        width: min(root.width - 16px, 560px);
        close-policy: close-on-click-outside;
        Rectangle {
            background: Theme.bg;
            border-color: Palette.border;
            border-width: 1px;
            border-radius: 6px;
            VerticalLayout {
                padding: 12px;
                spacing: 8px;
                Text {
                    text: "Download a link";
                    font-weight: 600;
                }
                url := LineEdit {
                    placeholder-text: "https://…";
                    accepted => {
                        root.add-url(self.text);
                        self.text = "";
                        add-popup.close();
                    }
                }
                HorizontalLayout {
                    alignment: end;
                    spacing: 8px;
                    Button {
                        text: "Cancel";
                        clicked => {
                            add-popup.close();
                        }
                    }
                    Button {
                        text: "Download";
                        primary: true;
                        clicked => {
                            root.add-url(url.text);
                            url.text = "";
                            add-popup.close();
                        }
                    }
                }
            }
        }
    }

    settings-popup := PopupWindow {
        x: root.width - min(root.width - 16px, 520px) - 8px;
        y: 44px;
        width: min(root.width - 16px, 520px);
        close-policy: close-on-click-outside;
        Rectangle {
            background: Theme.bg;
            border-color: Palette.border;
            border-width: 1px;
            border-radius: 6px;
            VerticalLayout {
                padding: 12px;
                spacing: 10px;
                Text {
                    text: "Settings";
                    font-weight: 600;
                }
                Field {
                    label: "Download folder";
                    LineEdit {
                        text <=> root.s-folder;
                    }
                }
                Field {
                    label: "Connections per file";
                    ComboBox {
                        model: ["1", "2", "4", "8", "16", "24", "32"];
                        current-index <=> root.s-connections-index;
                    }
                }
                Field {
                    label: "Speed limit";
                    LineEdit {
                        placeholder-text: "none, or e.g. 500K, 2M";
                        text <=> root.s-limit;
                    }
                }
                CheckBox {
                    text: "Catch downloads from the browser";
                    checked <=> root.s-catch;
                }
                HorizontalLayout {
                    alignment: end;
                    spacing: 8px;
                    Button {
                        text: "Cancel";
                        clicked => {
                            settings-popup.close();
                        }
                    }
                    Button {
                        text: "Save";
                        primary: true;
                        clicked => {
                            root.save-settings();
                            settings-popup.close();
                        }
                    }
                }
            }
        }
    }

    VerticalLayout {
        padding: 6px;
        spacing: 6px;

        HorizontalLayout {
            spacing: 6px;
            Button {
                text: "+ Add URL";
                primary: true;
                clicked => {
                    add-popup.show();
                }
            }
            Button {
                text: "Pause";
                enabled: root.selected-id >= 0;
                clicked => {
                    root.pause(root.selected-id);
                }
            }
            Button {
                text: "Resume";
                enabled: root.selected-id >= 0;
                clicked => {
                    root.resume(root.selected-id);
                }
            }
            Button {
                text: "Delete";
                enabled: root.selected-id >= 0;
                clicked => {
                    root.remove(root.selected-id);
                }
            }
            Button {
                text: "Open folder";
                enabled: root.selected-id >= 0;
                clicked => {
                    root.open-folder(root.selected-id);
                }
            }
            Rectangle {
                horizontal-stretch: 1;
            }
            Button {
                text: "Settings";
                clicked => {
                    settings-popup.show();
                }
            }
        }

        Rectangle {
            height: 26px;
            background: Palette.alternate-background;
            HorizontalLayout {
                padding-left: 8px;
                padding-right: 8px;
                spacing: 8px;
                Cell {
                    text: "Name";
                    font-weight: 600;
                    horizontal-stretch: 1;
                }
                Cell {
                    text: "Size";
                    font-weight: 600;
                    width: 80px;
                }
                Cell {
                    text: "Done";
                    font-weight: 600;
                    width: 150px;
                }
                Cell {
                    text: "Speed";
                    font-weight: 600;
                    width: 90px;
                }
                Cell {
                    text: "ETA";
                    font-weight: 600;
                    width: 60px;
                }
                Cell {
                    text: "Status";
                    font-weight: 600;
                    width: 100px;
                }
            }
        }

        // Right-click a download: everything that can be done with it. One menu for
        // the whole list (a menu inside a ListView row doesn't open); rows open it.
        list-menu := ContextMenuArea {
            vertical-stretch: 1;
            // Only the rows open it, so it is always about the row under the pointer.
            enabled: false;
            Menu {
                MenuItem {
                    title: "Open";
                    enabled: root.selected-row.done;
                    activated => {
                        root.open-file(root.selected-id);
                    }
                }
                MenuItem {
                    title: "Open folder";
                    activated => {
                        root.open-folder(root.selected-id);
                    }
                }
                MenuSeparator { }
                MenuItem {
                    title: "Pause";
                    enabled: root.selected-row.active;
                    activated => {
                        root.pause(root.selected-id);
                    }
                }
                MenuItem {
                    title: "Resume";
                    enabled: !root.selected-row.done && !root.selected-row.active;
                    activated => {
                        root.resume(root.selected-id);
                    }
                }
                MenuSeparator { }
                MenuItem {
                    title: "Copy link";
                    activated => {
                        root.copy-text(root.selected-row.url);
                    }
                }
                MenuSeparator { }
                MenuItem {
                    title: "Remove from list";
                    activated => {
                        root.remove(root.selected-id);
                    }
                }
                MenuItem {
                    title: "Delete file…";
                    enabled: root.selected-row.done;
                    activated => {
                        root.confirm-id = root.selected-id;
                        root.confirm-name = root.selected-row.name;
                        confirm-popup.show();
                    }
                }
            }

            ListView {
                for row[i] in root.rows: Rectangle {
                    height: 28px;
                    background: row.id == root.selected-id ? Palette.selection-background : Math.mod(i, 2) == 1 ? Palette.alternate-background : transparent;
                    HorizontalLayout {
                        padding-left: 8px;
                        padding-right: 8px;
                        spacing: 8px;
                        Cell {
                            text: row.name;
                            horizontal-stretch: 1;
                            color: row.id == root.selected-id ? Palette.selection-foreground : Palette.foreground;
                        }
                        Cell {
                            text: row.size;
                            width: 80px;
                        }
                        HorizontalLayout {
                            width: 150px;
                            spacing: 6px;
                            alignment: center;
                            Rectangle {
                                height: 8px;
                                horizontal-stretch: 1;
                                border-radius: 4px;
                                background: Theme.track;
                                Rectangle {
                                    x: 0;
                                    width: parent.width * clamp(row.progress, 0, 1);
                                    border-radius: 4px;
                                    background: Palette.accent-background;
                                }
                            }
                            Cell {
                                text: Math.round(row.progress * 100) + "%";
                                width: 36px;
                            }
                        }
                        Cell {
                            text: row.speed;
                            width: 90px;
                        }
                        Cell {
                            text: row.eta;
                            width: 60px;
                        }
                        Cell {
                            text: row.status;
                            width: 100px;
                        }
                    }
                    TouchArea {
                        clicked => {
                            root.select(row.id);
                        }
                        double-clicked => {
                            if row.done {
                                root.open-file(row.id);
                            }
                        }
                        // Right-click: select the row (so the menu is clearly about it),
                        // then open the list's menu where the pointer is.
                        pointer-event(e) => {
                            if e.kind == PointerEventKind.down && e.button == PointerEventButton.right {
                                root.select(row.id);
                                list-menu.show({
                                    x: self.absolute-position.x - list-menu.absolute-position.x + self.mouse-x,
                                    y: self.absolute-position.y - list-menu.absolute-position.y + self.mouse-y,
                                });
                            }
                        }
                    }
                }
            }
        }

        Cell {
            text: root.details;
            height: 20px;
        }

        // The selected download's segments: one block per piece, filled as it arrives.
        Rectangle {
            height: 18px;
            border-radius: 3px;
            background: Palette.alternate-background;
            for s in root.segments: Rectangle {
                x: parent.width * s.x;
                y: 2px;
                width: max(parent.width * s.w - 1px, 1px);
                height: parent.height - 4px;
                Rectangle {
                    x: 0;
                    width: parent.width * s.fill;
                    border-radius: 2px;
                    background: Palette.accent-background;
                }
            }
        }

        Text {
            text: root.status-text;
            color: Palette.foreground;
            font-size: 11px;
        }
    }
}

export component CaughtPopup inherits Window {
    title: "Slipstream";
    background: Theme.bg;
    icon: @image-url("../../../assets/icons/slipstream-128.png");
    always-on-top: true;
    width: 440px;
    height: 150px;

    in property <string> name;
    in property <string> info;
    callback open-folder();
    callback cancel-download();
    callback dismiss();

    VerticalLayout {
        padding: 14px;
        spacing: 6px;
        Text {
            text: "Download caught from the browser";
            font-weight: 700;
        }
        Text {
            text: root.name;
            overflow: elide;
        }
        Text {
            text: root.info;
            overflow: elide;
            opacity: 0.75;
        }
        Rectangle {
            vertical-stretch: 1;
        }
        HorizontalLayout {
            alignment: end;
            spacing: 8px;
            Button {
                text: "Cancel download";
                clicked => {
                    root.cancel-download();
                }
            }
            Button {
                text: "Open folder";
                clicked => {
                    root.open-folder();
                }
            }
            Button {
                text: "OK";
                primary: true;
                clicked => {
                    root.dismiss();
                }
            }
        }
    }
}
